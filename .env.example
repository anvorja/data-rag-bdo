# Variables de entorno del proyecto. Documentadas SIN valores.
#   - Los valores reales van en un .env local (ignorado por git) o en GitHub Secrets.
#   - Nunca escribirlos en el código, en los documentos del corpus ni en el chat.
#   - Cargar antes de correr los scripts:  set -a; . ./.env; set +a
VOYAGE_API_KEY=          # embeddings Voyage (pipeline/13_embeddings_api.py). dash.voyageai.com -> API Keys
OPENAI_API_KEY=          # embeddings OpenAI, solo para la comparación (descartado como candidato)
DEEPSEEK_API_KEY=        # LLM juez/redactor de la fase 3b (pipeline/fase3b/suficiencia.py). platform.deepseek.com -> API keys
# DEEPSEEK_MODEL=deepseek-flash                # opcional: deepseek-flash (por defecto) o deepseek-v4-pro. El código siempre desactiva el modo thinking
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # opcional
# OPENAI_MODEL_JUEZ=                           # obligatoria SOLO si se usa OpenAI como LLM de la fase 3b: nombre del modelo de chat elegido
# RAG_BASE=/ruta/al/repositorio   # opcional: raíz usada por los scripts de pipeline/
